# Application
SERVER_PORT=8080

# JWT — must be at least 32 characters; never commit a real secret
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_EXPIRATION_MS=3600000

# PostgreSQL
POSTGRES_DB=gateway_db
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
DB_URL=jdbc:postgresql://postgres:5432/gateway_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting (requests per minute per tier)
RATE_LIMIT_FREE_RPM=10
RATE_LIMIT_PRO_RPM=60
